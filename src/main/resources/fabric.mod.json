{
	"schemaVersion": 1,
	"id": "questviewer",
	"version": "${version}",
	"name": "QuestViewer",
	"description": "QuestViewer allows you to check your active Hypixel quest progress in-game without interacting with the Quest Master",
	"authors": [
		"Skorlex"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Skorlex/Hypixel-QuestViewer"
	},
	"license": "CC0-1.0",
	"icon": "assets/questviewer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"skorlex.questviewer.QuestViewer"
		],
		"client": [
			"skorlex.questviewer.client.QuestViewerClient"
		]
	},
	"mixins": [
		"questviewer.mixins.json",
		{
			"config": "questviewer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}